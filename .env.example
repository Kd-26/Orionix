# Never place credentials or customer payloads in this file.
LLMOPT_ENVIRONMENT=development
LLMOPT_LOG_LEVEL=INFO
LLMOPT_LOG_FORMAT=console
LLMOPT_CONTROL_PLANE__URL=
LLMOPT_AGENT__AGENT_ID=
LLMOPT_AGENT__CREDENTIAL=
LLMOPT_DATABASE__URL=
LLMOPT_STORAGE__ROOT=.llmopt/storage
LLMOPT_BENCHMARK__OUTPUT_DIR=benchmark-output
LLMOPT_OPTIMIZER__PROFILE=default
LLMOPT_TELEMETRY__ENABLED=false
